# Multi-language sandbox image: Python 3.10, GCC/g++ 11, OpenJDK 17.
#
# Build from the project root (the build context must contain runner/harness.py):
#   docker build -f docker/Dockerfile.runner -t rce-runner:latest .
#
# Runtime hardening (read-only rootfs, no network, dropped caps, cgroup limits,
# pids limit) is applied per-container by executor.py, not baked in here.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        g++ \
        openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged execution identity (matches SandboxConfig.sandbox_user).
RUN groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sandbox

# Strip setuid/setgid binaries: nothing in here should ever escalate privileges.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true

# Harness is root-owned and read-only to the sandbox user.
COPY runner/harness.py /opt/runner/harness.py
RUN chown -R root:root /opt/runner \
    && chmod 755 /opt/runner \
    && chmod 644 /opt/runner/harness.py \
    && mkdir -p /sandbox \
    && chown root:root /sandbox

WORKDIR /sandbox
USER sandbox:sandbox

# No ENTRYPOINT/CMD on purpose: the executor passes the harness command explicitly.
